// Guard public RunState constructor inputs. These records must not mutate.
import class RunKey, RunState from "../src/run_ledger";
import fnc start, enqueue, claim, cancel, finish from "../src/run_ledger";

pub routine main(): int {
  val RunKey key = new RunKey("t", "harden", 3);
  val RunState bad_phase = new RunState(key, 8, 2, 4, 2, 0, 0, 0, 0, 1);
  if enqueue(rt borrow bad_phase, rt borrow key, 2).is_ok(); then return 1; fi
  val RunState negative_pending = new RunState(key, 1, 2, 4, 2, 0, -1, 0, 0, 1);
  if claim(rt borrow negative_pending, rt borrow key, 2).is_ok(); then return 2; fi
  val RunState oversized_pending = new RunState(key, 1, 2, 4, 2, 0, 3, 0, 0, 1);
  if cancel(rt borrow oversized_pending, rt borrow key, 2).is_ok(); then return 3; fi
  val RunState impossible_total = new RunState(key, 1, 2, 2, 2, 2, 1, 0, 0, 3);
  if finish(rt borrow impossible_total, rt borrow key, 2).is_ok(); then return 4; fi
  val RunState mismatch_a = new RunState(key, 1, 3, 4, 2, 0, 0, 1, 0, 2);
  if cancel(rt borrow mismatch_a, rt borrow key, 3).is_ok(); then return 5; fi
  val RunState mismatch_b = new RunState(key, 1, 3, 4, 2, 0, 0, 0, 3, 2);
  if cancel(rt borrow mismatch_b, rt borrow key, 3).is_ok(); then return 6; fi
  val RunState negative_version = new RunState(key, 1, -1, 4, 2, 0, 0, 0, 0, 1);
  if enqueue(rt borrow negative_version, rt borrow key, -1).is_ok(); then return 7; fi
  val RunState negative_complete = new RunState(key, 1, 3, 4, 2, -1, 0, 0, 0, 1);
  if cancel(rt borrow negative_complete, rt borrow key, 3).is_ok(); then return 8; fi
  val RunState bad_next = new RunState(key, 1, 3, 4, 2, 0, 0, 0, 0, 0);
  if cancel(rt borrow bad_next, rt borrow key, 3).is_ok(); then return 9; fi
  val RunState done_with_pending = new RunState(key, 2, 3, 4, 2, 0, 1, 0, 0, 1);
  if cancel(rt borrow done_with_pending, rt borrow key, 3).is_ok(); then return 10; fi
  val RunState negative_limit = new RunState(key, 1, 3, -1, 2, 0, 0, 0, 0, 1);
  if finish(rt borrow negative_limit, rt borrow key, 3).is_ok(); then return 11; fi
  val RunState bad_mailbox = new RunState(key, 1, 3, 4, 0, 0, 0, 0, 0, 1);
  if cancel(rt borrow bad_mailbox, rt borrow key, 3).is_ok(); then return 12; fi
  val RunState created_with_steps = new RunState(key, 0, 1, 4, 2, 1, 0, 0, 0, 2);
  if start(rt borrow created_with_steps, rt borrow key, 1).is_ok(); then return 13; fi
  val RunState future_issue = new RunState(key, 1, 5, 4, 2, 0, 0, 1, 6, 2);
  if cancel(rt borrow future_issue, rt borrow key, 5).is_ok(); then return 14; fi
  val RunState serial_mismatch = new RunState(key, 1, 5, 4, 2, 0, 0, 2, 4, 3);
  if cancel(rt borrow serial_mismatch, rt borrow key, 5).is_ok(); then return 15; fi
  val RunState impossible_claim_count = new RunState(key, 1, 5, 4, 2, 0, 0, 0, 0, 3);
  if cancel(rt borrow impossible_claim_count, rt borrow key, 5).is_ok(); then return 16; fi
  val RunState not_started_running = new RunState(key, 1, 1, 4, 2, 0, 0, 0, 0, 1);
  if cancel(rt borrow not_started_running, rt borrow key, 1).is_ok(); then return 17; fi
  stdio.stdout.write("SG_RUN_MALFORMED_PASS");
  return 0;
}
