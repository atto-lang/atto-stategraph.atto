// Public constructors are not trusted: reject impossible history/counters.
import class RunKey, RunState from "../src/run_ledger";
import fnc start, enqueue, claim, cancel, fail, finish from "../src/run_ledger";

pub routine main(): int {
  val RunKey key = new RunKey("guard", "invariants", 1);
  val RunState wrong_active_serial = new RunState(
    key, 1, 4, 4, 2, 0, 0, 3, 4, 3);
  if cancel(rt borrow wrong_active_serial, rt borrow key, 4).is_ok(); then
    return 1;
  fi
  val RunState too_early_claim = new RunState(
    key, 1, 4, 4, 2, 0, 0, 1, 3, 2);
  if cancel(rt borrow too_early_claim, rt borrow key, 4).is_ok(); then
    return 2;
  fi
  val RunState future_claim = new RunState(
    key, 1, 4, 4, 2, 0, 0, 1, 5, 2);
  if cancel(rt borrow future_claim, rt borrow key, 4).is_ok(); then
    return 3;
  fi
  val RunState phantom_publication = new RunState(
    key, 1, 4, 4, 2, 1, 0, 0, 0, 1);
  if finish(rt borrow phantom_publication, rt borrow key, 4).is_ok(); then
    return 4;
  fi
  val RunState prestart_step = new RunState(
    key, 0, 1, 4, 2, 1, 0, 0, 0, 2);
  if start(rt borrow prestart_step, rt borrow key, 1).is_ok(); then return 5; fi
  val RunState prestart_mutation = new RunState(
    key, 0, 2, 4, 2, 0, 0, 0, 0, 1);
  if start(rt borrow prestart_mutation, rt borrow key, 2).is_ok(); then
    return 6;
  fi
  val RunState prestart_active = new RunState(
    key, 0, 1, 4, 2, 0, 0, 1, 1, 2);
  if start(rt borrow prestart_active, rt borrow key, 1).is_ok(); then return 7; fi
  val RunState forged_start = new RunState(
    key, 1, 1, 4, 2, 0, 0, 0, 0, 1);
  if enqueue(rt borrow forged_start, rt borrow key, 1).is_ok(); then return 8; fi
  val RunState illegal_total = new RunState(
    key, 1, 7, 2, 2, 2, 1, 0, 0, 3);
  if cancel(rt borrow illegal_total, rt borrow key, 7).is_ok(); then return 9; fi
  val RunState future_version = new RunState(
    key, 1, 2147483646, 4, 2, 0, 0, 0, 0, 1);
  if enqueue(rt borrow future_version, rt borrow key, 2147483646).is_ok(); then
    return 10;
  fi
  val RunState terminal_with_claim = new RunState(
    key, 4, 5, 4, 2, 0, 0, 1, 4, 2);
  if cancel(rt borrow terminal_with_claim, rt borrow key, 5).is_ok(); then
    return 11;
  fi
  val RunState bad_bound = new RunState(
    key, 1, 3, 4, 1025, 0, 0, 0, 0, 1);
  if fail(rt borrow bad_bound, rt borrow key, 3).is_ok(); then return 12; fi
  stdio.stdout.write("SG_RUN_CORRUPT_CLAIMS_PASS");
  return 0;
}
