// CREATED can be cancelled without ever executing or allocating a worker.
import class RunKey, RunState from "../src/run_ledger";
import fnc create, start, enqueue, claim, cancel, fail, finish from "../src/run_ledger";

pub routine main(): int {
  val RunState initial = create("sandbox", "never-started", 1, 4, 3).unwrap();
  val RunKey key = new RunKey("sandbox", "never-started", 1);
  val RunState stopped = cancel(rt borrow initial, rt borrow key, 1).unwrap();
  if stopped.phase != 3 || stopped.version != 2; then return 1; fi
  if stopped.completed_steps != 0 || stopped.pending != 0 ||
     stopped.in_flight != 0 || stopped.claim_version != 0; then return 2; fi
  if start(rt borrow stopped, rt borrow key, 2).is_ok(); then return 3; fi
  if enqueue(rt borrow stopped, rt borrow key, 2).is_ok(); then return 4; fi
  if claim(rt borrow stopped, rt borrow key, 2).is_ok(); then return 5; fi
  if cancel(rt borrow stopped, rt borrow key, 2).is_ok(); then return 6; fi
  if fail(rt borrow stopped, rt borrow key, 2).is_ok(); then return 7; fi
  if finish(rt borrow stopped, rt borrow key, 2).is_ok(); then return 8; fi
  if initial.phase != 0 || initial.version != 1; then return 9; fi
  stdio.stdout.write("SG_RUN_CANCEL_CREATED_PASS");
  return 0;
}
