import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, expect_false, expect_equal_int, expect_equal_string, expect_near_float, run_suite, require_success, fail from "ores.std/testing";
import class StateGraph, Node, Edge, RunResult from "../src/stategraph";
fnc always(String state): bool { return true; }
fnc identity(String node, String state): String { return state; }
fnc rejects_zero_step_budget(): TestOutcome {
  val StateGraph<String> graph = new StateGraph<String>(
    arr[new Node<String>("a", identity)],
    arr[new Edge<String>("START", "a", always), new Edge<String>("a", "END", always)], 0
  );
  return expect_equal_string(graph.validate(), "invalid_budget",
    "a zero step budget must be rejected before execution");
}
fnc rejects_unknown_edge_target(): TestOutcome {
  val StateGraph<String> graph = new StateGraph<String>(
    arr[new Node<String>("a", identity)],
    arr[new Edge<String>("START", "a", always), new Edge<String>("a", "other", always)], 4
  );
  return expect_equal_string(graph.validate(), "unknown_target",
    "unregistered graph destinations must not be invoked");
}
fnc reserved_end_node_denied(): TestOutcome {
  val StateGraph<String> graph = new StateGraph<String>(
    arr[new Node<String>("END", identity)],
    arr[new Edge<String>("START", "END", always)], 4
  );
  return expect_equal_string(graph.validate(), "reserved_node",
    "terminal sentinel cannot be registered as a callable node");
}
fnc duplicate_node_name_is_rejected(): TestOutcome {
  val StateGraph<String> graph = new StateGraph<String>(
    arr[new Node<String>("a", identity), new Node<String>("a", identity)],
    arr[new Edge<String>("START", "a", always), new Edge<String>("a", "END", always)], 8
  );
  return expect_equal_string(graph.validate(), "duplicate_node",
    "graph must reject ambiguous node identities before callbacks");
}

fnc missing_start_edge_is_rejected(): TestOutcome {
  val StateGraph<String> graph = new StateGraph<String>(
    arr[new Node<String>("a", identity)],
    arr[new Edge<String>("a", "END", always)], 8
  );
  return expect_equal_string(graph.validate(), "missing_start",
    "graph must have a START transition");
}

pub routine main(): void {
  val TestSuite suite = new TestSuite("stategraph", arr[
    new TestCase("rejects_zero_step_budget", rejects_zero_step_budget, false, ""),
    new TestCase("rejects_unknown_edge_target", rejects_unknown_edge_target, false, ""),
    new TestCase("reserved_end_node_denied", reserved_end_node_denied, false, ""),
    new TestCase("duplicate_node_name_is_rejected", duplicate_node_name_is_rejected, false, ""),
    new TestCase("missing_start_edge_is_rejected", missing_start_edge_is_rejected, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
